# Copy this file to .env and fill in what you need. Never commit .env.

DATABASE_URL=postgresql://mr:mr@localhost:5432/mr_summarizer

# Which LLM answers questions: "anthropic" or "ollama"
LLM_PROVIDER=anthropic

# Anthropic (Claude Console API key, not your claude.ai login)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Ollama (free, runs locally: https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
